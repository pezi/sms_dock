{
  "name": "smsdock-client",
  "version": "0.1.0",
  "description": "Node.js client and command-line tool for the SMS Dock WebSocket API",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "smsdock": "bin/smsdock.js"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sms",
    "smsdock",
    "websocket",
    "android"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  }
}
