#!/bin/sh
# Runs the smsdock command-line tool built by "dotnet build -c Release".
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
dll=${SMSDOCK_DLL:-"$here/../src/SmsDock.Cli/bin/Release/net8.0/SmsDock.Cli.dll"}
if [ ! -f "$dll" ]; then
    echo "smsdock: $dll not found. Run 'dotnet build -c Release' in $(dirname -- "$here") first." >&2
    exit 2
fi
exec dotnet "$dll" "$@"
