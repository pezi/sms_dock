<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SmsDock.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SmsDock/SmsDock.csproj" />
    <ProjectReference Include="../../src/SmsDock.Cli/SmsDock.Cli.csproj" />
    <ProjectReference Include="../../examples/AutoReply/AutoReply.csproj" />
    <!-- Built before the tests, which run them as programs. -->
    <ProjectReference Include="../../examples/ListMessages/ListMessages.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../examples/SendSms/SendSms.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../examples/ListenIncoming/ListenIncoming.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
